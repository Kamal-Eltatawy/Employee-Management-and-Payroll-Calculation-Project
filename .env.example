# Copy this file to .env and change every value. .env is git-ignored.
# MSSQL_SA_PASSWORD must satisfy SQL Server's password policy (8+ chars, 3 of: upper, lower, digit, symbol)
# and must match the Password in ConnectionStrings__Default.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!Pass
ConnectionStrings__Default=Server=localhost,1433;Database=Payroll;User Id=sa;Password=ChangeMe_Str0ng!Pass;Encrypt=True;TrustServerCertificate=True

# JWT (used from Phase 7). SigningKey must be at least 32 characters.
Jwt__Issuer=payroll-api
Jwt__Audience=payroll-client
Jwt__SigningKey=replace-with-a-random-string-of-at-least-32-chars

# Development seed users (used from Phase 7)
Seed__HrPassword=ChangeMe_Hr1!
Seed__EmployeePassword=ChangeMe_Emp1!
